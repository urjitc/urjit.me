{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "urjit-me",
  "compatibility_date": "2026-07-09",
  "workers_dev": true,
  "preview_urls": true,
  // Only the homepage runs through it: Markdown for agents that ask (worker/index.ts).
  "main": "./worker/index.ts",
  // Apex only. www → urjit.me is a Cloudflare Redirect Rule (not _redirects).
  // Requires urjit.me to be an active zone on this account before deploy succeeds.
  "routes": [
    {
      "pattern": "urjit.me",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
